{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttendanceResponse",
  "description": "Schema for Attendance response payload",
  "type": "object",
  "required": [
    "attendance_id",
    "employee_id",
    "date",
    "work_hours",
    "status",
    "created_at"
  ],
  "properties": {
    "attendance_id": {
      "type": "string",
      "pattern": "^ATT-\\d+$"
    },
    "employee_id": {
      "type": "string",
      "pattern": "^EMP-\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "work_hours": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 16.0
    },
    "status": {
      "type": "string",
      "enum": ["Present", "Absent", "Half-Day", "Remote"]
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
